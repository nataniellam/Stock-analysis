# Required everywhere, including local dev - quotes, charts, and search come from Twelve Data.
# Get a free key at https://twelvedata.com (sign up -> API key is on your dashboard).
# Free tier: 800 requests/day, 8/min - the backend caches (5 min for quotes, 24 hr for
# charts) to stay comfortably under that for personal use.
TWELVE_DATA_API_KEY=

# Also required - stock fundamentals (market cap, P/E, sector, description, etc.) come from
# Financial Modeling Prep instead of Twelve Data, whose free tier only covers one demo symbol
# for this data. Get a free key at https://site.financialmodelingprep.com/developer/docs
# (250 requests/day free), signup required.
FMP_API_KEY=

# Leave both unset for local development - the app falls back to local JSON files
# (backend/watchlist.json, portfolio.json, alerts.json).
#
# Set both in production (e.g. on Render) so data survives redeploys. Get these from
# an Upstash Redis database at https://upstash.com (free tier) -> Details -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional locally; set on Render to your deployed frontend's URL once you have it.
CORS_ORIGIN=
