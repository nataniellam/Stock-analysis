# Required everywhere, including local dev - market data comes from Alpha Vantage.
# Get a free key at https://www.alphavantage.co/support/#api-key (just an email, instant).
# Free tier: 25 requests/day, 5/min - the backend caches aggressively (30 min for quotes,
# 24 hr for charts/fundamentals) to stay under that for personal use.
ALPHA_VANTAGE_API_KEY=

# Leave both unset for local development - the app falls back to local JSON files
# (backend/watchlist.json, portfolio.json, alerts.json).
#
# Set both in production (e.g. on Render) so data survives redeploys. Get these from
# an Upstash Redis database at https://upstash.com (free tier) -> Details -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional locally; set on Render to your deployed frontend's URL once you have it.
CORS_ORIGIN=
